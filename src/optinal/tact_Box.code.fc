#pragma version =0.4.4;
#pragma allow-post-modification;
#pragma compute-asm-ltr;

#include "tact_Box.headers.fc";
#include "tact_Box.stdlib.fc";
#include "tact_Box.storage.fc";

;;
;; Contract Box functions
;;

(slice, slice, int) $Box$_contract_init(slice $treasury, slice $owner) impure inline_ref {
    var (($self'treasury, $self'owner, $self'balance)) = (null(), null(), null());
    $self'treasury = $treasury;
    $self'owner = $owner;
    $self'balance = 0;
    return ($self'treasury, $self'owner, $self'balance);
}

((slice, slice, int), int) $Box$_fun_balance((slice, slice, int) $self) impure inline_ref {
    var (($self'treasury, $self'owner, $self'balance)) = $self;
    var $fresh$ret_6 = $self'balance;
    return (($self'treasury, $self'owner, $self'balance), $fresh$ret_6);
}

((slice, slice, int), slice) $Box$_fun_getTON((slice, slice, int) $self) impure inline_ref {
    var (($self'treasury, $self'owner, $self'balance)) = $self;
    var $fresh$ret_7 = $Int$_fun_toCoinsString($global_myBalance());
    return (($self'treasury, $self'owner, $self'balance), $fresh$ret_7);
}

;;
;; Receivers of a Contract Box
;;

(((slice, slice, int)), ()) $Box$_internal_binary_InternalAddTokens((slice, slice, int) $self, (int, slice) $msg) impure inline {
    var ($self'treasury, $self'owner, $self'balance) = $self;
    var ($msg'amount, $msg'origin) = $msg;
    if (( __tact_slice_eq_bits($self'treasury, $msg'origin) )) {
        throw_unless(17409, ( __tact_slice_eq_bits($self'treasury, __tact_context_get_sender()) ));
    }
    $self'balance = ($self'balance + $msg'amount);
    return (($self'treasury, $self'owner, $self'balance), ());
}

((slice, slice, int), ()) $Box$_internal_text_5092b5dce0715a57dd969f5fb5a6f93025a0b02eab329470ca2b365ca0d7e93a((slice, slice, int) $self) impure inline {
    var ($self'treasury, $self'owner, $self'balance) = $self;
    throw_unless(27921, ( __tact_slice_eq_bits($self'owner, __tact_context_get_sender()) ));
    $global_send($SendParameters$_constructor_to_bounce_value_mode($self'owner, true, 0, 130));
    return (($self'treasury, $self'owner, $self'balance), ());
}

(((slice, slice, int)), ()) $Box$_internal_binary_Deploy((slice, slice, int) $self, (int) $deploy) impure inline {
    var ($self'treasury, $self'owner, $self'balance) = $self;
    var ($deploy'queryId) = $deploy;
    ($self'treasury, $self'owner, $self'balance)~$Box$_fun_notify($DeployOk$_store_cell($DeployOk$_constructor_queryId($deploy'queryId)));
    return (($self'treasury, $self'owner, $self'balance), ());
}

;;
;; Get methods of a Contract Box
;;

_ %balance() method_id(104128) {
    var self = $Box$_contract_load();
    var res = self~$Box$_fun_balance();
    return res;
}

_ %getTON() method_id(70560) {
    var self = $Box$_contract_load();
    var res = self~$Box$_fun_getTON();
    return res;
}

_ lazy_deployment_completed() method_id {
    return get_data().begin_parse().load_int(1);
}

;;
;; Routing of a Contract Box
;;

((slice, slice, int), int) $Box$_contract_router_internal((slice, slice, int) self, int msg_bounced, slice in_msg) impure inline_ref {
    ;; Handle bounced messages
    if (msg_bounced) {
        return (self, true);
    }
    
    ;; Parse incoming message
    int op = 0;
    if (slice_bits(in_msg) >= 32) {
        op = in_msg.preload_uint(32);
    }
    
    
    ;; Receive InternalAddTokens message
    if (op == 3781127134) {
        var msg = in_msg~$InternalAddTokens$_load();
        self~$Box$_internal_binary_InternalAddTokens(msg);
        return (self, true);
    }
    
    ;; Receive Deploy message
    if (op == 2490013878) {
        var msg = in_msg~$Deploy$_load();
        self~$Box$_internal_binary_Deploy(msg);
        return (self, true);
    }
    
    ;; Text Receivers
    if (op == 0) {
        var text_op = slice_hash(in_msg);
        
        ;; Receive "withdraw all" message
        if (text_op == 0x5092b5dce0715a57dd969f5fb5a6f93025a0b02eab329470ca2b365ca0d7e93a) {
            self~$Box$_internal_text_5092b5dce0715a57dd969f5fb5a6f93025a0b02eab329470ca2b365ca0d7e93a();
            return (self, true);
        }
    }
    
    return (self, false);
}

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    var msg_flags = cs~load_uint(4);
    var msg_bounced = -(msg_flags & 1);
    slice msg_sender_addr = __tact_verify_address(cs~load_msg_addr());
    __tact_context = (msg_bounced, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var self = $Box$_contract_load();
    
    ;; Handle operation
    int handled = self~$Box$_contract_router_internal(msg_bounced, in_msg);
    
    ;; Throw if not handled
    throw_unless(130, handled);
    
    ;; Persist state
    $Box$_contract_store(self);
}
